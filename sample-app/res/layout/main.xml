<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="32dp"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="Sign in" android:textSize="28sp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/email" android:hint="Email"
        android:layout_marginTop="24dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/signin" android:text="Sign in"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/welcome" android:text="Welcome back!" android:textSize="22sp"
        android:visibility="gone" android:layout_marginTop="32dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
